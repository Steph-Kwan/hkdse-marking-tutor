# 复制成 .env 再填。.env 已在 .gitignore，不会被 commit 上 GitHub。
#
#   cp .env.example .env
#   npm run test:api     ← 测通不通，并列出可用模型
#   npm run dev

# API 网址，结尾不要加斜线，也不要带 /v1
# 官方：https://api.anthropic.com
# 中转站：填你自己的网址
API_BASE_URL=https://api.anthropic.com

# 你的密钥。绝对不要把这个档案以外的地方写上真实密钥。
API_KEY=sk-your-key-here

# 上游认哪种格式：openai 或 anthropic
# 不确定就跑 npm run test:api，它会两种都试一遍再告诉你
API_FORMAT=anthropic

# 模型名称。跑 npm run test:api 会列出这个站台开放哪些
API_MODEL=claude-sonnet-5

# 单次回覆上限。判分内容长，建议 2000 以上
API_MAX_TOKENS=2000

# 本机开发用的端口，不填预设 5173
PORT=5173
